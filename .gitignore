# Repo-wide — applies at any depth, so packages/bricks that don't have
# their own .gitignore (e.g. cli/chameleon_cli, a plain Dart package) are
# still covered.

# Build artifacts
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
**/doc/api/

# fvm's local SDK symlink cache — .fvmrc itself is committed
.fvm/

# `mason get` regenerates both from mason.yaml, and bakes in an absolute
# local path — committing them would point at a path that doesn't exist
# on anyone else's machine.
/.mason/
/mason-lock.json

# melos bootstrap writes this per package for local cross-linking; it's
# regenerated by `melos bootstrap`, not meant to be committed
pubspec_overrides.yaml

# IDE
.idea/
*.iml
*.ipr
*.iws
#.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
